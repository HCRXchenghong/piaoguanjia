[Unit]
Description=Invoice Hub (票管家) - team invoice management
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/invoice-hub
Environment=INVOICE_DSN=invoice:Invoice%402026@tcp(127.0.0.1:3306)/invoice?charset=utf8mb4&parseTime=true&loc=Local
ExecStart=/opt/invoice-hub/server/bin/invoice-server-linux-amd64 -addr :8686 -web web/dist -data server/data
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
